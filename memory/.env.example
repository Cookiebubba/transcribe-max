# Copy to memory/.env and fill in. Load with: set -a; . memory/.env; set +a

# --- Graph backend (Neo4j by default; start it with docker-compose.yml) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
# To use FalkorDB instead of Neo4j:
# GRAPHITI_DB=falkordb
# FALKORDB_HOST=localhost
# FALKORDB_PORT=6379

# --- Provider A: Claude + Voyage (default if ANTHROPIC_API_KEY is set) ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# GRAPHITI_LLM_MODEL=claude-sonnet-5
# GRAPHITI_SMALL_MODEL=claude-haiku-4-5-20251001
# GRAPHITI_EMBED_MODEL=voyage-3.5
# GRAPHITI_EMBED_DIM=1024

# --- Provider B: OpenAI single-key mode (used if only OPENAI_API_KEY is set) ---
# OPENAI_API_KEY=
# GRAPHITI_LLM_MODEL=gpt-4.1-mini
# GRAPHITI_EMBED_MODEL=text-embedding-3-small
# GRAPHITI_EMBED_DIM=1536

# Force a provider regardless of keys present:
# GRAPHITI_PROVIDER=anthropic   # or: openai
